#include <iostream>
#include <fstream>
#include <string>
using namespace std;

class ProgramLoader {
public:
    static bool loadFromFile(string filename, Memory& mem) {
        ifstream file(filename);
        if (!file.is_open()) return false;

        string line;
        int addr = 0;

        while (file >> line) {
            if (line[0] == ';') {
                getline(file, line);
                continue;
            }

            if (line.length() == 4) {
                int byte1 = stoi(line.substr(0, 2), nullptr, 16);
                int byte2 = stoi(line.substr(2, 2), nullptr, 16);

                mem.write(addr++, byte1);
                mem.write(addr++, byte2);
            }
        }
        file.close();
        return true;
    }
};

class VoleMachine {
private:
    Memory memory;
    RegisterFile registers;
    CPU cpu;
    Screen screen;

public:
    VoleMachine() : cpu(memory, registers, screen) {}

    bool loadProgram(string filename) {
        reset();
        return ProgramLoader::loadFromFile(filename, memory);
    }

    void runStep() {
        if (!cpu.isHalted()) {
            cpu.fetchAndExecuteStep();
        }
    }

    void runAll() {
        while (!cpu.isHalted()) {
            cpu.fetchAndExecuteStep();
        }
    }

    void reset() {
        memory.clear();
        registers.clear();
        cpu.reset();
        screen.clear();
    }

    Memory& getMemory() { return memory; }
    RegisterFile& getRegisters() { return registers; }
    CPU& getCPU() { return cpu; }
    Screen& getScreen() { return screen; }
};

class ConsoleUI {
private:
    VoleMachine machine;

    void displayState() {
        cout << "PC: " << hex << (int)machine.getCPU().getPC() << "\n";
        for (int i = 0; i < 16; i++) {
            cout << "R" << i << ": " << (int)machine.getRegisters().read(i) << "\t";
            if ((i + 1) % 4 == 0) cout << "\n";
        }
        cout << "Screen: " << machine.getScreen().getOutput() << "\n";
    }

public:
    void start() {
        int choice = 0;
        string filename;

        while (choice != 6) {
            cout << "\n1. Load\n2. Step\n3. Run All\n4. Display\n5. Reset\n6. Exit\nChoice: ";
            cin >> choice;

            if (choice == 1) {
                cin >> filename;
                machine.loadProgram(filename);
            } 
            else if (choice == 2) {
                machine.runStep();
                displayState();
            } 
            else if (choice == 3) {
                machine.runAll();
                displayState();
            } 
            else if (choice == 4) {
                displayState();
            } 
            else if (choice == 5) {
                machine.reset();
            }
        }
    }
};
